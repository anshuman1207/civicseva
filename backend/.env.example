# Server
PORT=5000
NODE_ENV=development

# Database
# - Local: mongodb://localhost:27017/civicseva
# - Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/civicseva
MONGO_URI=mongodb://localhost:27017/civicseva

# Auth
JWT_SECRET=replace_this_with_secure_key_in_production

# CORS — Your deployed frontend URL (no trailing slash)
# e.g. https://civicseva.vercel.app
CLIENT_URL=http://localhost:5173

# Cloudinary (optional — for image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
